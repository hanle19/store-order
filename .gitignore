node_modules
**/node_modules

# 运行时密钥（首次运行自动生成，切勿提交）
server/.jwt_secret

# SQLite 运行时数据（部署时单独备份，不要入库）
server/data/*.db
server/data/*.db-shm
server/data/*.db-wal

# 备份与杂项
*.backup*
store-order-*-backup
.DS_Store

# 回收/暂存（genie-safe-delete 归档，非业务文件）
.trash/
.trash/**

# Vite 临时构建缓存（无引用，自动生成）
*.timestamp-*.mjs

# 空占位库（真实库在 server/data/store.db）
server/store.db

# 回滚点归档
server/backups/

# 便携 Node 运行时（约 100M，不入库；克隆后用本机 Node 或单独放置 nodejs/）
nodejs/

# 前端构建产物（由 deploy.bat / Dockerfile 重新生成，勿入库）
client/dist/
server/public/

# 全局排除 SQLite 数据库与 WAL（含嵌套/备份路径，防真实业务数据泄露）
**/*.db
**/*.db-shm
**/*.db-wal

# 本地项目记忆 / 产物（WorkBuddy 会话数据，不入库）
.workbuddy/

# 运行时日志（访问日志可能含请求 URL / IP，勿入库）
server/logs/
